{
  "name": "dsh-route-gate",
  "version": "0.5.0",
  "description": "Route first, work second: a DSH plugin that makes every session present a route card for human approval and hard-blocks mutating tools until it is approved.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/design.md",
    "docs/card-mock.png"
  ],
  "scripts": {
    "test": "node --test test/policy.test.js test/apply.test.js test/weight.test.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "route-gate",
    "plan",
    "guardrail"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.5-rc.3 <1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5-rc.3 <1",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.3 <1",
    "@deepseek-ai/dsh-user-questions": ">=0.1.5-rc.3 <1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangShTo/dsh-plugins.git",
    "directory": "packages/route-gate"
  },
  "homepage": "https://github.com/WangShTo/dsh-plugins/tree/master/packages/route-gate",
  "bugs": {
    "url": "https://github.com/WangShTo/dsh-plugins/issues"
  }
}
